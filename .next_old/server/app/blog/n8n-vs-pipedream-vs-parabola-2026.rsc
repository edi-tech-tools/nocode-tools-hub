1a:["$","tr","2",{"className":"border-b border-[#3b2566]/50 hover:bg-[#2a1a4e]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#c4b5fd]","children":"**Error Tracing & Observability**"}],["$","td","1",{"className":"px-4 py-3 text-[#c4b5fd]","children":"End-to-end execution logs, node-level error context, retry policies with exponential backoff, and integrated Sentry/Datadog hooks; trace IDs propagated across async executions"}],["$","td","2",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Real-time execution graphs, structured JSON logs, automatic anomaly detection (via ML-powered Failure Insights), and root-cause suggestions (2025.3 release)"}],["$","td","3",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Visual error highlighting per step; CSV-based debug exports; limited log retention (<7 days); no distributed tracing"}]]}]
1b:["$","tr","3",{"className":"border-b border-[#3b2566]/50 hover:bg-[#2a1a4e]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#c4b5fd]","children":"**Enterprise Security**"}],["$","td","1",{"className":"px-4 py-3 text-[#c4b5fd]","children":"SOC 2 Type II (2025), GDPR/CCPA-ready, SSO (SAML/OIDC), RBAC with granular permission tiers, audit log export"}],["$","td","2",{"className":"px-4 py-3 text-[#c4b5fd]","children":"FedRAMP Moderate compliant (achieved March 2026), zero-trust network model, field-level encryption at rest/in transit, automated secrets rotation"}],["$","td","3",{"className":"px-4 py-3 text-[#c4b5fd]","children":"SOC 2 Type I (2025), basic SSO, static role permissions (Admin/Editor/Viewer), no audit log API or custom retention policy"}]]}]
1c:["$","tr","4",{"className":"border-b border-[#3b2566]/50 hover:bg-[#2a1a4e]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#c4b5fd]","children":"**Low-Code Extensibility**"}],["$","td","1",{"className":"px-4 py-3 text-[#c4b5fd]","children":"JavaScript/TypeScript function nodes, CLI-driven custom node development, npm integration, GitHub-synced node registries"}],["$","td","2",{"className":"px-4 py-3 text-[#c4b5fd]","children":"$$send and $respond APIs, Node.js runtime (v20+), custom component SDK with local dev server, GitHub Actions CI/CD templates"}],["$","td","3",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Formula language (ParabolaQL) + Python snippets (sandboxed, max 30s runtime); no external package imports; no custom node publishing"}]]}]
1d:["$","tr","5",{"className":"border-b border-[#3b2566]/50 hover:bg-[#2a1a4e]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#c4b5fd]","children":"**Data Volume & Throughput**"}],["$","td","1",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Handles 10M+ records/batch via streaming mode; memory-efficient chunking; horizontal scaling via Redis cluster"}],["$","td","2",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Optimized for high-frequency, low-payload events (e.g., webhook bursts); throughput degrades >50K rows without batch pre-aggregation"}],["$","td","3",{"className":"px-4 py-3 text-[#c4b5fd]","children":"UI-limited to ~500K rows per sheet; backend processing caps at 2M rows/hour; no streaming—full load required"}]]}]
1e:["$","tr","6",{"className":"border-b border-[#3b2566]/50 hover:bg-[#2a1a4e]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#c4b5fd]","children":"**Collaboration & Governance**"}],["$","td","1",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Git-sync for version-controlled workflows (with diffing), branch protection, PR-style review workflows, and changelog history"}],["$","td","2",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Shared environments with approval gates, environment-specific secrets, and drift-detection alerts (EnvGuardian feature)"}],["$","td","3",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Shared workspaces with comment threads; no version history for edits; change tracking only at workbook level"}]]}]
1f:["$","tr","7",{"className":"border-b border-[#3b2566]/50 hover:bg-[#2a1a4e]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#c4b5fd]","children":"**Pricing Transparency**"}],["$","td","1",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Open-core: free self-hosted tier; cloud plans start at $29/mo (5k executions); enterprise pricing public on website"}],["$","td","2",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Usage-based: $0.001/exec + $0.02/GB processed; flat-rate enterprise plans include SLA and concierge onboarding"}],["$","td","3",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Tiered by active users + monthly row volume; no usage overages—but row caps enforced silently with auto-throttling"}]]}]
20:["$","tr","8",{"className":"border-b border-[#3b2566]/50 hover:bg-[#2a1a4e]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#c4b5fd]","children":"**Analyst & Ops Fit**"}],["$","td","1",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Steeper learning curve for non-devs; strong for engineers building reusable workflow libraries"}],["$","td","2",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Ideal for dev-adjacent product/ops teams fluent in JSON/webhooks; less intuitive for spreadsheet-first users"}],["$","td","3",{"className":"px-4 py-3 text-[#c4b5fd]","children":"Lowest barrier to entry; drag-and-drop + formula UX resonates with marketers, sales ops, and BI analysts—but lacks pipeline composability"}]]}]
